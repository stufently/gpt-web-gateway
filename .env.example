# --- Server ---
PORT=3000

# Optional app-level auth for /v1/* and /login/* routes.
# When set, requests must send `Authorization: Bearer <API_KEY>` or Basic auth
# with any username and API_KEY as the password. /health and /metrics stay open.
# When unset the gateway is open (put Basic auth on your reverse proxy instead).
# API_KEY=

# --- Browser ---
# Browser mode: "default" | "chrome" | "cdp"
#   default — Playwright Chromium + persisted session (auth/session.json)
#   chrome  — system Chrome with your profile (Chrome must be closed!)
#   cdp     — connect to an already running Chrome with --remote-debugging-port
BROWSER_MODE=default

# Headless mode (true/false). Keep this FALSE: a headless build is an anti-bot signal that no
# JS evasion fixes, and the image runs the browser under Xvfb so no display is required.
HEADLESS=false

# Browser engine (2.11.0+): patchright (default, real Google Chrome) | stealth (legacy).
# BROWSER_ENGINE=stealth

# For BROWSER_MODE=chrome — Chrome profile (auto-detected if empty)
# CHROME_USER_DATA_DIR=
# CHROME_PROFILE=Default

# For BROWSER_MODE=cdp
# CDP_URL=http://127.0.0.1:9222

# --- Anti-bot / egress (see docs/2026-07-26-cloudflare-block-fingerprint-vs-egress.md) ---
# Cloudflare retry policy. The challenge verdict is decided PER NAVIGATION: the same address
# that is challenged now is served HTTP 200 on a fresh goto about a minute later, and once
# through, the access holds. So the way out is to navigate again — not to sit on the
# interstitial, which is what turned a recoverable challenge into a 34-hour outage.
# CF_LOAD_ATTEMPTS=2
# CF_RETRY_GAP_SEC=45
# CF_CHALLENGE_GRACE_SEC=15
# Wall-clock ceiling for the whole sequence, navigations included. 90s is what is left of a
# ~600s client budget after the answer wait (360) and its extension (120) — raise it only
# together with the client/ingress timeouts.
# CF_LOAD_BUDGET_SEC=90

# Route the browser out through another address. Helps against a genuinely distrusted egress
# IP, but try the retry above FIRST — it clears this failure without a proxy. Chromium
# implements proxy authentication for http(s) proxies only; socks proxies must be
# unauthenticated. Not applied when BROWSER_MODE=cdp (launch that Chrome with --proxy-server=).
# PROXY_SERVER=http://proxy.example.com:8888
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Pin the browser's user agent. Normally leave unset: the browser's own UA (as rewritten by
# the stealth bundle) is self-consistent, and a pin that disagrees with the platform or the
# client hints is an anti-bot signal rather than a disguise. When set, the value is installed
# INSIDE the stealth bundle — note that its user-agent evasion deliberately masks Linux as
# Windows, so the platform part of what you pin will be rewritten (coherently).
# BROWSER_USER_AGENT=

# Which Chromium build to drive. Empty = Playwright's bundled headless shell.
# "chromium" = the full build in new-headless mode: closer to real Chrome, but roughly twice
# the browser memory (~722 MB vs ~377 MB idle, measured). Did not change the Cloudflare
# outcome in either direction, so it is opt-in.
# CHROMIUM_CHANNEL=

# --- ChatGPT account (optional, enables auto-login when the session expires) ---
# CHATGPT_EMAIL=
# CHATGPT_PASSWORD=
# CHATGPT_TOTP_SECRET=

# --- Queue / rate limiting ---
# MAX_QUEUE_SIZE=5
# MAX_BATCH_N=10
# QUEUE_FULL_RETRY_AFTER_SEC=60
# RATE_LIMIT_COOLDOWN_MINUTES=30
# Proactive gap between upstream turns (seconds). Protects the ChatGPT account
# from a batch client that would otherwise fire prompt after prompt for hours —
# the account's own anti-abuse locks the human owner out of their interactive
# session too. A batch of n images pays this n-1 times. Keep it well below
# HEALTH_STUCK_SEC. 0 disables it.
# MIN_JOB_GAP_SEC=60

# --- Image generation timeouts ---
# GENERATION_TIMEOUT_SEC=240
# GENERATION_RETRY_TIMEOUT_SEC=90
# GENERATION_MAX_TIMEOUT_SEC=600
# RENDER_WAIT_SEC=15
# UPLOAD_MAX_ATTEMPTS=3

# --- Uploads / capabilities ---
# MAX_UPLOAD_BYTES=52428800
# CAPABILITIES_CACHE_TTL_MS=60000

# --- Text chat timeouts ---
# CHAT_COMPLETION_TIMEOUT_SEC=360
# CHAT_COMPLETION_RETRY_TIMEOUT_SEC=120
# CHAT_STALL_WINDOW_SEC=120
# CHAT_STREAM_RESCUE_SEC=60
# CHATGPT_TEXT_RETRY_ATTEMPTS=4
# CHATGPT_TEXT_HARD_RESET=true

# --- Advanced features (verified on the live ChatGPT UI, 2026-07-18) ---
# Read assistant answers from ChatGPT's own backend-api traffic (passive
# page.on('response') interception + an injected fetch tee for live SSE deltas)
# instead of scraping the DOM. DOM scraping stays as the fallback. Also the
# prerequisite for stream:true in /v1/chat/completions. Default ON; set 0 to
# fall back to pure DOM scraping.
# READ_VIA_BACKEND_API=1

# Trim GET /backend-api/conversation/{id} responses to the last N messages of the
# active branch (long chats freeze the tab). Client-side load optimization only —
# the server-side conversation context is untouched. 0 = off.
# CONVERSATION_TRIM_LIMIT=0

# Once per process, PATCH the account settings that control ChatGPT "memory" to
# false (deterministic, closer-to-stateless answers). ACCOUNT-WIDE side effect,
# hence opt-in. Verified: "reference chat history" toggles fine; "saved memories"
# (sunshine) can be server-gated (403) — then disable it manually in ChatGPT
# settings. Best-effort with logging, never a hard failure.
# DISABLE_CHATGPT_MEMORY=0

# --- Intelligence tiers: automatic downgrade ---
# The account's Pro quota runs out periodically. When a `thinking_mode=pro` request
# cannot actually get Pro (item missing / greyed out / the click leaves the pill
# unmoved), the request is served on the next tier down instead of silently running
# at whatever level the composer happened to show. The response says so:
# `applied.thinking_mode=extra_high`, `applied.requested_verified=false`,
# `applied.thinking_fallback={from,to,reason}`, while `requested.thinking_mode` still
# reads `pro`. Set to off/none/empty to disable and restore the old behavior; any
# other tier name (e.g. `extended`) redirects the downgrade there.
# TIER_FALLBACK_PRO=extra_high

# How long a tier proven unavailable is skipped outright, so a run of Pro requests
# does not each pay ~3 s of opening the menu and failing. Cleared early the moment the
# tier is selected successfully (or if the pill already shows it). 0 = re-probe every
# request. Only STRONG evidence memoizes: an explicitly disabled item or the
# post-submit limit notice at once, a missing item after two consecutive sightings,
# and an unverified click never.
# TIER_UNAVAILABLE_COOLDOWN_SEC=900

# --- Health / liveness ---
# HEALTH_STUCK_SEC=900
# HEALTH_FAILURE_STREAK=3

# --- Debugging (opt-in; snapshots may contain prompts) ---
# DEBUG_SNAPSHOTS=0
# DEBUG_SNAPSHOT_DIR=/tmp/chatgpt-debug
